{
  "name": "realestate",
  "version": "1.0.0",
  "description": "Automated web scraper for collecting real estate listings from multiple property websites",
  "author": "Laura Melita",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20.6.0"
  },
  "imports": {
    "#app": "./src/app.js",
    "#scheduler": "./src/scheduler.js",
    "#config/*": "./src/config/*.js",
    "#controllers/*": "./src/controllers/*.js",
    "#jobs/*": "./src/jobs/*.js",
    "#middlewares/*": "./src/middlewares/*.js",
    "#models/*": "./src/models/*.js",
    "#routes/*": "./src/routes/*.js",
    "#scrapers/*": "./src/scrapers/*.js",
    "#services/*": "./src/services/*.js",
    "#utils/*": "./src/utils/*.js"
  },
  "scripts": {
    "server": "node --import=extensionless/register src/server.js",
    "scheduler": "node --import=extensionless/register src/scheduler.js",
    "dev": "run-p server scheduler",
    "format": "prettier --write ."
  },
  "dependencies": {
    "axios": "^1.16.0",
    "chalk": "^5.4.1",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-sanitizer": "^1.0.6",
    "extensionless": "^1.9.9",
    "helmet": "^8.1.0",
    "http-errors": "^2.0.0",
    "mongoose": "^8.23.1",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3",
    "node-telegram-bot-api": "^0.67.0",
    "puppeteer": "^24.4.0",
    "qs": "^6.14.0",
    "user-agents": "^1.1.493",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "eslint": "^10.3.0",
    "nodemon": "^3.1.14",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.3"
  }
}
