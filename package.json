{
  "name": "realestate",
  "version": "1.0.0",
  "description": "Automated web scraper for collecting real estate listings from multiple property websites",
  "author": "Laura Melita",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20.6.0"
  },
  "imports": {
    "#app": "./src/app.js",
    "#config/*": "./src/config/*.js",
    "#middlewares/*": "./src/middlewares/*.js",
    "#routes/*": "./src/routes/*.js",
    "#scheduler/*": "./src/scheduler/*.js",
    "#services/*": "./src/services/*.js",
    "#utils/*": "./src/utils/*.js"
  },
  "scripts": {
    "start": "node --import=extensionless/register src/server.js",
    "dev": "nodemon --exec node --import=extensionless/register src/server.js",
    "format": "prettier --write ."
  },
  "dependencies": {
    "axios": "^1.8.4",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-sanitizer": "^1.0.6",
    "extensionless": "^1.9.9",
    "helmet": "^8.1.0",
    "http-errors": "^2.0.0",
    "mongoose": "^8.12.2",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3",
    "node-telegram-bot-api": "^0.66.0",
    "puppeteer": "^24.4.0",
    "user-agents": "^1.1.486"
  },
  "devDependencies": {
    "eslint": "^9.23.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.5.3"
  }
}
