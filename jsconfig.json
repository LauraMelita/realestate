{
  "compilerOptions": {
    "baseUrl": "./src",
    "paths": {
      "#app": ["app.js"],
      "#scheduler": ["scheduler.js"],
      "#config/*": ["config/*"],
      "#controllers/*": ["controllers/*"],
      "#middlewares/*": ["middlewares/*"],
      "#models/*": ["models/*"],
      "#routes/*": ["routes/*"],
      "#scrapers/*": ["scrapers/*"],
      "#services/*": ["services/*"],
      "#utils/*": ["utils/*"]
    }
  },
  "include": ["src"]
}
